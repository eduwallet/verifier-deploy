# Admin token of the dev sandbox issuer
ISSUER_DEV_SANDBOX=

# Base URL of the sandbox issuer (this is the default)
#ISSUER_SANDBOX_URL=https://sandbox.issuer.dev.eduwallet.nl

# Session cookie Secure flag. TLS is terminated by Traefik, so the container cannot detect HTTPS itself.
# Use false for local development over plain http.
DEMO_COOKIE_SECURE=true

# Include the (redacted) upstream calls as 'trace' in the API responses
DEMO_TRACE=true
